{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
    "../server/agent-core.ts",
    ".cloudflare/types/index.d.ts"
  ],
  "exclude": [
    "*.test.ts",
    "vitest.config.ts"
  ]
}
