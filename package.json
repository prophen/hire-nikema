{
  "name": "hire-nikema",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "test": "vitest run",
    "og": "node scripts/og/render.mjs",
    "agent": "tsx --env-file-if-exists=.env.agent server/index.ts",
    "test:agent": "tsx --test server/*.test.ts",
    "build:agent": "npm run build && npm run types:agent && tsx scripts/build-agent.ts",
    "check:agent": "tsc -p worker/tsconfig.json",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "types:agent": "cd worker && cf workers types --include-runtime=false",
    "deploy:agent": "npm run build:agent && node scripts/deploy-agent.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@twilio/voice-sdk": "^2.19.0",
    "astro": "^7.4.13",
    "posthog-js": "^1.453.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "twilio": "^6.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "cf": "^0.15.0",
    "chromatic": "^18.15.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
