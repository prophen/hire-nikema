# Copy to .env.agent. Never put server secrets in PUBLIC_ variables.
PORT=3001
SITE_ORIGIN=http://localhost:4321
# Public HTTPS origin of this service (no trailing path).
AGENT_PUBLIC_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
# Persistent writable path. Run exactly one service instance.
AGENT_BUDGET_FILE=.agent-state/budget.json
