---
// Composes the full page. Interactive pieces hydrate; everything else ships as static HTML.
import { profile } from "../data/profile";
import type { Company } from "../data/companies";
import { Hero } from "./Hero";
import { FitList } from "./FitList";
import { Projects } from "./Projects";
import { HowIWork } from "./HowIWork";
import { ContentCommunity } from "./ContentCommunity";
import { Testimonials } from "./Testimonials";
import { NowAndLogistics } from "./NowAndLogistics";
import { RoleFitChecker } from "./RoleFitChecker";
import { Footer } from "./Footer";
interface Props { company?: Company }
const { company } = Astro.props;
---
<main class="page">
  <Hero client:load profile={profile} companyNote={company} />
  <FitList {...profile.fit} />
  <Projects projects={profile.projects} more={profile.moreProjects} />
  <ContentCommunity content={profile.content} community={profile.community} />
  <HowIWork items={profile.howIWork} />
  <Testimonials items={profile.testimonials} />
  <RoleFitChecker client:visible />
  <NowAndLogistics now={profile.now} logistics={profile.logistics} />
  <Footer client:visible profile={profile} />
</main>
